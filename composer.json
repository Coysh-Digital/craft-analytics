{
    "name": "coyshdigital/craft-analytics",
    "description": "Privacy-first, consent-aware analytics for Craft CMS. First-party, cookieless by default, and it never sends your visitors' data anywhere.",
    "type": "craft-plugin",
    "license": "proprietary",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "analytics",
        "privacy",
        "gdpr"
    ],
    "authors": [
        {
            "name": "Coysh Digital",
            "homepage": "https://coysh.digital"
        }
    ],
    "support": {
        "email": "support@coysh.digital",
        "issues": "https://github.com/Coysh-Digital/craft-analytics/issues",
        "source": "https://github.com/Coysh-Digital/craft-analytics",
        "docs": "https://coysh.digital/plugins/craft-analytics/docs"
    },
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0",
        "donatj/phpuseragentparser": "^1.8",
        "jaybizzle/crawler-detect": "^1.2",
        "maxmind-db/reader": "^1.11"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "pestphp/pest": "^3.0 || ^4.0",
        "yiisoft/yii2-redis": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "coyshdigital\\craftanalytics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "coyshdigital\\craftanalytics\\tests\\": "tests/"
        }
    },
    "extra": {
        "handle": "craft-analytics",
        "name": "Craft Analytics",
        "developer": "Coysh Digital",
        "developerUrl": "https://coysh.digital",
        "documentationUrl": "https://coysh.digital/plugins/craft-analytics/docs",
        "changelogUrl": "https://raw.githubusercontent.com/Coysh-Digital/craft-analytics/main/CHANGELOG.md",
        "class": "coyshdigital\\craftanalytics\\Plugin",
        "editions": [
            "lite",
            "pro"
        ]
    },
    "scripts": {
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix",
        "phpstan": "phpstan --memory-limit=1G",
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": false,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
