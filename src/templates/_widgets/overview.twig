{% import 'craft-analytics/_partials/macros.twig' as ca %}

<div class="ca">
    {% if totals.views > 0 %}
        {# Formatted value per metric, so the loop below stays about layout. The
           keys match StatsService::totals() and OverviewWidget::metricLabels(). #}
        {% set formatted = {
            views: ca.compact(totals.views),
            uniques: ca.compact(totals.uniques),
            sessions: ca.compact(totals.sessions),
            bounceRate: totals.bounceRate|number_format(0) ~ '%',
            avgViewsPerSession: totals.avgViewsPerSession|number_format(1),
            avgDurationMs: ca.duration(totals.avgDurationMs),
            avgDwellMs: totals.avgDwellMs ? ca.duration(totals.avgDwellMs) : '-',
        } %}
        <div class="ca-sidebar-stats" style="margin-bottom: 12px; flex-wrap: wrap; gap: 14px 18px">
            {# Iterate the canonical order, not the order they were picked. #}
            {% for key, label in metricLabels %}
                {% if key in metrics %}
                    <div class="ca-sidebar-stat">
                        <div class="ca-kpi-label">{{ label }}</div>
                        <div class="ca-kpi-value">{{ formatted[key] }}</div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>

        {% set spark = craft.craftAnalytics.sparklinePath(trend.views, 300, 40) %}
        {% if spark %}
            <svg class="ca-sparkline" style="height: 40px" viewBox="0 0 300 40" preserveAspectRatio="none" role="img"
                 aria-label="{{ 'Views over the selected period'|t('craft-analytics') }}">
                <path d="{{ spark }}" fill="none" stroke="var(--ca-views)" stroke-width="1.5"
                      stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"></path>
            </svg>
        {% endif %}

        <p style="margin-top: 10px">
            <a class="go" href="{{ url('craft-analytics', { site: site.handle, range: range.param }) }}">
                {{ 'Open analytics'|t('craft-analytics') }}
            </a>
        </p>
    {% else %}
        <p class="ca-muted">{{ 'No traffic recorded for this period yet.'|t('craft-analytics') }}</p>
    {% endif %}
</div>
