{% extends '_layouts/cp.twig' %}

{% set docTitle = title ~ ' - ' ~ 'Analytics'|t('craft-analytics') %}

{% set selectedSubnavItem = selectedSubnavItem ?? 'dashboard' %}

{% set crumbs = [] %}

{% block actionButton %}
    {# Only where there is actually something to export — a button that
       quietly exports a different screen's data is worse than no button. #}
    {# `is defined` is true for a variable set to null, so a screen that has
       nothing to export says so with null rather than by omitting the key. #}
    {% if (canExport ?? false) and (exportKind ?? null) %}
        <div class="btngroup">
            <a class="btn" href="{{ url('craft-analytics/export/' ~ exportKind, exportParams ?? {}) }}">
                {{ 'Export CSV'|t('craft-analytics') }}
            </a>
        </div>
    {% endif %}
{% endblock %}

{% set showRanges = showRanges ?? true %}

{% block content %}
    <div class="ca">
        {% if sites|length > 1 or showRanges %}
            <div class="ca-toolbar">
                {% if showRanges %}
                    <div class="ca-ranges" role="group" aria-label="{{ 'Date range'|t('craft-analytics') }}">
                        {% for value, label in ranges %}
                            <a class="ca-range{{ value == range.preset ? ' is-selected' }}"
                               href="{{ url(currentPath, currentParams|merge({ range: value })) }}"
                               {{ value == range.preset ? 'aria-current="true"' }}>{{ label }}</a>
                        {% endfor %}

                        {# A disclosure and a plain GET form, so an absolute
                           range needs no JavaScript at all. The two date fields
                           post as `from` and `to`; the controller resolves them
                           once and every link on the resulting page carries the
                           combined token instead. #}
                        <details class="ca-range-custom" {{ range.isCustom ? 'open' }}>
                            <summary class="ca-range{{ range.isCustom ? ' is-selected' }}">
                                {{ range.isCustom ? range.label : 'Custom'|t('craft-analytics') }}
                            </summary>
                            <form class="ca-range-form" method="get">
                                {# Carries whatever else the screen is scoped by
                                   - the site, a page path, the Pages filters -
                                   so applying a range never silently drops a
                                   filter or bounces back to the list. `range`
                                   is skipped because `from`/`to` replace it. #}
                                {% for key, value in currentParams|filter((value, key) => key != 'range' and value is not iterable) %}
                                    <input type="hidden" name="{{ key }}" value="{{ value }}">
                                {% endfor %}
                                <label>
                                    <span>{{ 'From'|t('craft-analytics') }}</span>
                                    <input type="date" class="text" name="from" required
                                           value="{{ range.from }}" max="{{ maxDate ?? '' }}">
                                </label>
                                <label>
                                    <span>{{ 'To'|t('craft-analytics') }}</span>
                                    <input type="date" class="text" name="to" required
                                           value="{{ range.to }}" max="{{ maxDate ?? '' }}">
                                </label>
                                <button type="submit" class="btn submit">{{ 'Apply'|t('craft-analytics') }}</button>
                            </form>
                        </details>
                    </div>
                {% endif %}

                <div class="ca-spacer"></div>

                {% if sites|length > 1 %}
                    <div class="select">
                        <select onchange="window.location = this.value;" aria-label="{{ 'Site'|t('craft-analytics') }}">
                            {% for s in sites %}
                                <option value="{{ url(currentPath, currentParams|merge({ site: s.handle })) }}"
                                        {{ s.id == site.id ? 'selected' }}>{{ s.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {% block report %}{% endblock %}
    </div>
{% endblock %}
