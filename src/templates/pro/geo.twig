{% extends 'craft-analytics/_layout.twig' %}
{% import 'craft-analytics/_partials/macros.twig' as ca %}

{% block report %}
    {% if not isPro %}
        {% include 'craft-analytics/_partials/pro-gate.twig' with {
            title: 'Locations'|t('craft-analytics'),
            description: 'See which countries and regions your visitors are in, resolved from a database on your own server. No lookup service is ever called and no address is stored.'|t('craft-analytics'),
        } only %}
    {% elseif not database.installed %}
        <div class="ca-card">
            <div class="ca-card-body">
                <div class="ca-posture is-consent">
                    <div class="ca-posture-icon" aria-hidden="true">!</div>
                    <div>
                        <div class="ca-posture-title">{{ 'No geolocation database installed'|t('craft-analytics') }}</div>
                        <p class="ca-posture-body">
                            {{ 'Locations are resolved from a database on this server - nothing is ever sent to a lookup service. Install one, and nothing downloads on its own:'|t('craft-analytics') }}
                        </p>
                        <pre class="ca-code" style="margin-top: 10px">php craft craft-analytics/geo/install --url=&lt;db-ip lite url&gt;
php craft craft-analytics/geo/status</pre>
                    </div>
                </div>
            </div>
        </div>
    {% elseif not enabled %}
        {{ ca.empty(
            'Location tracking is off'|t('craft-analytics'),
            'The database is installed. Turn on enableGeo to start resolving countries.'|t('craft-analytics')
        ) }}
    {% else %}
        {% if countries|length %}
            <div class="ca-card">
                <div class="ca-card-head">
                    <h2 class="ca-card-title">{{ 'Map'|t('craft-analytics') }}</h2>
                </div>
                <div class="ca-card-body">
                    <div id="ca-geo-map" style="width: 100%; height: 340px"></div>
                    {# Replaced by the map once it draws. If the map library
                       did not load - a cpresources publishing problem, or a
                       content security policy blocking it - this is what stays
                       on the screen, because a card that is simply blank tells
                       nobody anything. #}
                    <p id="ca-geo-map-fallback" class="ca-footnote" hidden>
                        {{ 'The map could not be drawn because its script did not load. The country figures below are unaffected. Check that the plugin resources under cpresources are being published and are not blocked.'|t('craft-analytics') }}
                    </p>
                </div>
            </div>

            {% js %}
                (function () {
                    var el = document.getElementById('ca-geo-map');
                    var fallback = document.getElementById('ca-geo-map-fallback');

                    if (!el) return;

                    function giveUp(reason) {
                        el.hidden = true;
                        if (fallback) fallback.hidden = false;
                        // Says so out loud, so the next person to look at a
                        // blank card has somewhere to start.
                        if (window.console) console.warn('craft-analytics: the Locations map could not be drawn - ' + reason);
                    }

                    if (typeof jsVectorMap === 'undefined') {
                        return giveUp('jsvectormap.min.js did not load.');
                    }

                    var values = {{ countryValues|json_encode|raw }};

                    // jsvectormap's scale is a lookup table, not a gradient:
                    // it fetches scale[value], so handing it session counts
                    // asks for scale[4213], gets undefined, and leaves the
                    // country with no fill at all - which paints it black,
                    // SVG's default. So the counts are bucketed here and the
                    // bucket is what the map is given.
                    //
                    // Buckets start at 1 because setValues() skips falsy
                    // ones, and a country in bucket 0 would go black for
                    // exactly the same reason.
                    var palette = ['#dbe4fb', '#bfd0f7', '#93b4f2', '#5f8de9', '#3b6fe0', '#2563eb'];
                    var scale = {};
                    var buckets = {};
                    var max = 0;
                    var code;

                    for (code in values) {
                        if (values[code] > max) max = values[code];
                    }

                    for (var i = 0; i < palette.length; i++) {
                        scale[i + 1] = palette[i];
                    }

                    for (code in values) {
                        // Square-rooted, so one dominant country does not
                        // flatten everywhere else into the palest shade.
                        var share = max > 0 ? Math.sqrt(values[code] / max) : 0;
                        buckets[code] = 1 + Math.round(share * (palette.length - 1));
                    }

                    try {
                        new jsVectorMap({
                            selector: '#ca-geo-map',
                            map: 'world_merc',
                            zoomButtons: false,
                            showTooltip: true,
                            series: {
                                regions: [{
                                    values: buckets,
                                    scale: scale,
                                }],
                            },
                            regionStyle: {
                                initial: { fill: '#e5e7eb' },
                            },
                            onRegionTooltipShow: function (event, tooltip, code) {
                                var sessions = values[code] || 0;
                                tooltip.text(tooltip.text() + ': ' + sessions.toLocaleString() + ' {{ 'sessions'|t('craft-analytics') }}');
                            },
                        });
                    } catch (e) {
                        // Most likely world-merc.js not loading, which leaves
                        // the library present but the map data missing.
                        giveUp(e && e.message ? e.message : 'the map data is unavailable.');
                    }
                })();
            {% endjs %}
        {% endif %}

        <div class="ca-card">
            <div class="ca-card-head">
                <h2 class="ca-card-title">{{ 'Countries'|t('craft-analytics') }}</h2>
            </div>
            <div class="ca-card-body ca-table-scroll">
                {% if countries|length %}
                    {% set maxSessions = max(countries|map(c => c.sessions)) %}
                    {% set total = countries|map(c => c.sessions)|reduce((a, b) => a + b, 0) %}
                    <table class="ca-table">
                        <thead>
                        <tr>
                            <th>{{ 'Country'|t('craft-analytics') }}</th>
                            <th class="ca-num">{{ 'Sessions'|t('craft-analytics') }}</th>
                            <th class="ca-num">{{ 'Share'|t('craft-analytics') }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for row in countries %}
                            <tr>
                                {{ ca.barCell(row.country, row.sessions, maxSessions, null) }}
                                <td class="ca-num">{{ row.sessions|number_format }}</td>
                                <td class="ca-num ca-muted">{{ total ? (row.sessions / total * 100)|number_format(1) ~ '%' : '-' }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    {{ ca.empty(
                        'No locations for this period'|t('craft-analytics'),
                        'Sessions appear once they have closed and the drain has run.'|t('craft-analytics')
                    ) }}
                {% endif %}
            </div>
        </div>

        {% if regions|length %}
            <div class="ca-card">
                <div class="ca-card-head">
                    <h2 class="ca-card-title">{{ 'Regions'|t('craft-analytics') }}</h2>
                </div>
                <div class="ca-card-body ca-table-scroll">
                    {% set maxRegion = max(regions|map(r => r.sessions)) %}
                    <table class="ca-table">
                        <thead>
                        <tr>
                            <th>{{ 'Region'|t('craft-analytics') }}</th>
                            <th>{{ 'Country'|t('craft-analytics') }}</th>
                            <th class="ca-num">{{ 'Sessions'|t('craft-analytics') }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for row in regions %}
                            <tr>
                                {{ ca.barCell(row.region, row.sessions, maxRegion, null) }}
                                <td class="ca-muted">{{ row.country }}</td>
                                <td class="ca-num">{{ row.sessions|number_format }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}

        <p class="ca-footnote">
            {% if blockCrawlers %}
                {{ 'Known crawlers and bots are filtered out before location data is recorded, so these figures only reflect human visitors. See the Crawlers report for what was kept out.'|t('craft-analytics') }}
            {% else %}
                {{ 'Crawler blocking is currently off (blockCrawlers), so bot traffic may be included in these figures.'|t('craft-analytics') }}
            {% endif %}
        </p>
    {% endif %}

    {% if isPro and database.installed %}
        <p class="ca-footnote">
            {{ 'Resolved on this server from {type}, built {built}. The address is looked up in memory and discarded - it is never stored, logged, or sent anywhere.'|t('craft-analytics', {
                type: database.type ?? 'a local database',
                built: database.buildDate ?? 'unknown',
            }) }}
            {% if attribution %}<br>{{ attribution }}{% endif %}
        </p>
    {% endif %}
{% endblock %}
