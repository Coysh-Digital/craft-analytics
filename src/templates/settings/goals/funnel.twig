{% extends '_layouts/cp.twig' %}
{% import '_includes/forms.twig' as forms %}

{% set title = isNew ? 'New funnel'|t('craft-analytics') : funnel.name %}
{% set docTitle = title ~ ' - ' ~ 'Craft Analytics'|t('craft-analytics') %}
{% set fullPageForm = not readOnly %}

{% set crumbs = [
    { label: 'Settings'|t('app'), url: url('settings') },
    { label: 'Plugins'|t('app'), url: url('settings/plugins') },
    { label: 'Craft Analytics'|t('craft-analytics'), url: url('settings/plugins/craft-analytics') },
    { label: 'Goals & funnels'|t('craft-analytics'), url: url('settings/plugins/craft-analytics/goals') }
] %}

{% block content %}
    <input type="hidden" name="action" value="craft-analytics/goals/save-funnel">
    <input type="hidden" name="redirect" value="{{ 'settings/plugins/craft-analytics/goals'|hash }}">
    {% if not isNew %}<input type="hidden" name="uid" value="{{ funnel.uid }}">{% endif %}

    {% if goals|length < 2 %}
        <div class="readable">
            <blockquote class="note warning">
                <p>{{ 'A funnel is built from goals, and there are fewer than two to choose from. Define the goals first — each step of the funnel is one of them.'|t('craft-analytics') }}</p>
            </blockquote>
        </div>
    {% endif %}

    {{ forms.textField({
        first: true,
        label: 'Name'|t('app'),
        id: 'name',
        name: 'name',
        value: funnel.name,
        errors: funnel.getErrors('name'),
        autofocus: true,
        required: true,
        disabled: readOnly
    }) }}

    {{ forms.textField({
        label: 'Handle'|t('app'),
        id: 'handle',
        name: 'handle',
        class: 'code',
        value: funnel.handle,
        errors: funnel.getErrors('handle'),
        required: true,
        disabled: readOnly
    }) }}

    {{ forms.editableTableField({
        label: 'Steps'|t('craft-analytics'),
        instructions: 'The goals that make up this funnel, in the order they should happen. A session that reaches step 3 without having reached step 2 first is not counted at step 3.'|t('craft-analytics'),
        id: 'steps',
        name: 'steps',
        cols: {
            goal: {
                type: 'select',
                heading: 'Goal'|t('craft-analytics'),
                options: goals|map(g => { label: g.name, value: g.handle })
            }
        },
        rows: funnel.steps|map(handle => { goal: handle }),
        errors: funnel.getErrors('steps'),
        addRowLabel: 'Add a step'|t('craft-analytics'),
        allowAdd: not readOnly,
        allowDelete: not readOnly,
        allowReorder: not readOnly,
        static: readOnly
    }) }}

    {{ forms.selectField({
        label: 'Site'|t('app'),
        id: 'siteId',
        name: 'siteId',
        options: [{ label: 'All sites'|t('craft-analytics'), value: '' }]|merge(
            sites|map(s => { label: s.name, value: s.id })
        ),
        value: funnel.siteId,
        disabled: readOnly
    }) }}

    {{ forms.lightswitchField({
        label: 'Enabled'|t('app'),
        id: 'enabled',
        name: 'enabled',
        on: funnel.enabled,
        disabled: readOnly
    }) }}

    <div class="readable" style="margin-top: 24px">
        <blockquote class="note">
            <p>{{ 'Funnels are measured within a single session. There is no cross-session funnel: the visitor hash is destroyed when the salt rotates each day, so a decision made over three visits is three sessions — and this reports each of them rather than inventing a link between them.'|t('craft-analytics') }}</p>
        </blockquote>
    </div>
{% endblock %}
