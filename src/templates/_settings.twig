{% import '_includes/forms.twig' as forms %}

{% if plugin.isFullPageCachingLikely() and settings.trackingMode == 'server' %}
    <div class="readable">
        <blockquote class="note warning">
            <p>
                {{ 'A full-page caching plugin is installed. Cached pages never reach PHP, so server-side tracking will silently under-count them — the numbers will look plausible and be wrong.'|t('craft-analytics') }}
                <strong>{{ 'Switch to hybrid mode'|t('craft-analytics') }}</strong>{{ ': the beacon fills the gap automatically, with no cache configuration needed.'|t('craft-analytics') }}
            </p>
        </blockquote>
    </div>
{% endif %}

{{ forms.selectField({
    label: 'Tracking mode'|t('craft-analytics'),
    instructions: 'Hybrid (recommended) captures server-side and uses the beacon to fill gaps from full-page caching and the back/forward cache, deduplicated by a one-time nonce.'|t('craft-analytics'),
    id: 'trackingMode',
    name: 'trackingMode',
    options: {
        hybrid: 'Hybrid (recommended)'|t('craft-analytics'),
        server: 'Server-side only'|t('craft-analytics'),
        client: 'Client beacon only'|t('craft-analytics'),
    },
    value: settings.trackingMode,
    errors: settings.getErrors('trackingMode'),
    warning: settings.trackingMode == 'server'
        ? 'Server-side only cannot measure time on page, and under-counts behind any full-page cache.'|t('craft-analytics')
        : null,
}) }}

{{ forms.lightswitchField({
    label: 'Inject the tracker automatically'|t('craft-analytics'),
    instructions: 'Adds the deferred, dependency-free tracker script before </body> on site pages. Turn off to place it yourself.'|t('craft-analytics'),
    id: 'injectScript',
    name: 'injectScript',
    on: settings.injectScript,
    errors: settings.getErrors('injectScript'),
}) }}

{{ forms.textField({
    label: 'Beacon path'|t('craft-analytics'),
    instructions: 'First-party site path the tracker posts to.'|t('craft-analytics'),
    id: 'beaconPath',
    name: 'beaconPath',
    value: settings.beaconPath,
    errors: settings.getErrors('beaconPath'),
}) }}

{{ forms.selectField({
    label: 'Write driver'|t('craft-analytics'),
    instructions: 'How captured hits reach the database. “Direct” is only suitable for low-traffic sites.'|t('craft-analytics'),
    id: 'writeDriver',
    name: 'writeDriver',
    options: {
        spool: 'Spool (recommended)'|t('craft-analytics'),
        queue: 'Dedicated queue'|t('craft-analytics'),
        direct: 'Direct (low traffic only)'|t('craft-analytics'),
    },
    value: settings.writeDriver,
    errors: settings.getErrors('writeDriver'),
}) }}

{{ forms.textField({
    label: 'Session window'|t('craft-analytics'),
    instructions: 'Seconds of inactivity before a session ends.'|t('craft-analytics'),
    id: 'sessionWindow',
    name: 'sessionWindow',
    type: 'number',
    size: 6,
    value: settings.sessionWindow,
    errors: settings.getErrors('sessionWindow'),
}) }}

{{ forms.lightswitchField({
    label: 'Honour Global Privacy Control'|t('craft-analytics'),
    instructions: 'Visitors sending Sec-GPC: 1 are never tracked beyond the anonymous tier.'|t('craft-analytics'),
    id: 'honourGpc',
    name: 'honourGpc',
    on: settings.honourGpc,
    errors: settings.getErrors('honourGpc'),
}) }}

<p class="light">
    {{ 'All settings can be overridden per environment in config/craft-analytics.php.'|t('craft-analytics') }}
</p>
