{# The summary email.

   Table-based, inline-styled and image-free on purpose: it has to survive
   Outlook, and there is no tracking pixel because a tool that reports on
   privacy-first analytics has no business tracking who opened its own email. #}
{% macro pct(value) %}
    {%- if value is null -%}
        <span style="color:#6b7280">n/a</span>
    {%- else -%}
        <span style="color:{{ value >= 0 ? '#047857' : '#b91c1c' }}">{{ value > 0 ? '+' }}{{ value|number_format(1) }}%</span>
    {%- endif -%}
{% endmacro %}

{% macro kpi(label, value, delta) %}
    {% import _self as f %}
    <td style="padding:14px 16px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:6px;vertical-align:top">
        <div style="font-size:12px;color:#6b7280;text-transform:uppercase;letter-spacing:.03em">{{ label }}</div>
        <div style="font-size:24px;font-weight:600;color:#111827;padding:2px 0">{{ value }}</div>
        <div style="font-size:12px;color:#6b7280">{{ f.pct(delta) }} vs previous</div>
    </td>
{% endmacro %}

{% import _self as f %}

<div style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#111827;max-width:640px;margin:0 auto;padding:24px">

    <h1 style="font-size:20px;margin:0 0 2px">{{ site.name }}</h1>
    <p style="margin:0 0 20px;color:#6b7280;font-size:14px">
        {{ range.label }} &middot; {{ range.from }} to {{ range.to }}
    </p>

    <table role="presentation" cellpadding="0" cellspacing="6" style="border-collapse:separate;width:100%">
        <tr>
            {{ f.kpi('Views'|t('craft-analytics'), totals.views|number_format, deltas.views) }}
            {{ f.kpi('Visitors'|t('craft-analytics'), totals.uniques|number_format, deltas.uniques) }}
            {{ f.kpi('Sessions'|t('craft-analytics'), totals.sessions|number_format, deltas.sessions) }}
        </tr>
    </table>

    {% if goals|length %}
        <h2 style="font-size:15px;margin:26px 0 8px">{{ 'Goals'|t('craft-analytics') }}</h2>
        <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;font-size:14px">
            {% for goal in goals %}
                <tr>
                    <td style="padding:7px 0;border-bottom:1px solid #f3f4f6">{{ goal.name }}</td>
                    <td style="padding:7px 0;border-bottom:1px solid #f3f4f6;text-align:right;white-space:nowrap">
                        <strong>{{ goal.conversions|number_format }}</strong>
                        <span style="color:#6b7280">({{ goal.rate|number_format(2) }}%)</span>
                        {% if goal.value %}<span style="color:#6b7280"> &middot; {{ goal.value|currency }}</span>{% endif %}
                    </td>
                </tr>
            {% endfor %}
        </table>
    {% endif %}

    {% if pages|length %}
        <h2 style="font-size:15px;margin:26px 0 8px">{{ 'Top pages'|t('craft-analytics') }}</h2>
        <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;font-size:14px">
            {% for page in pages %}
                <tr>
                    <td style="padding:7px 0;border-bottom:1px solid #f3f4f6;color:#374151">{{ page.path }}</td>
                    <td style="padding:7px 0;border-bottom:1px solid #f3f4f6;text-align:right;white-space:nowrap">
                        <strong>{{ page.views|number_format }}</strong>
                    </td>
                </tr>
            {% endfor %}
        </table>
    {% endif %}

    {% if sources|length %}
        <h2 style="font-size:15px;margin:26px 0 8px">{{ 'Top sources'|t('craft-analytics') }}</h2>
        <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;font-size:14px">
            {% for source in sources %}
                <tr>
                    <td style="padding:7px 0;border-bottom:1px solid #f3f4f6;color:#374151">{{ source.host ?: source.channel }}</td>
                    <td style="padding:7px 0;border-bottom:1px solid #f3f4f6;text-align:right;white-space:nowrap">
                        <strong>{{ source.sessions|number_format }}</strong>
                    </td>
                </tr>
            {% endfor %}
        </table>
    {% endif %}

    <p style="margin:26px 0 0">
        <a href="{{ url('craft-analytics') }}"
           style="display:inline-block;background:#2563eb;color:#fff;text-decoration:none;padding:9px 16px;border-radius:5px;font-size:14px">
            {{ 'Open the full reports'|t('craft-analytics') }}
        </a>
    </p>

    <p style="margin:22px 0 0;color:#6b7280;font-size:12px;line-height:1.6">
        {{ 'Visitor counts are on a daily-unique basis: someone who visits on three days counts three times. That is a deliberate privacy property rather than an error - the link between a visitor’s days is destroyed when the hashing salt rotates every 24 hours.'|t('craft-analytics') }}
    </p>
    <p style="margin:8px 0 0;color:#9ca3af;font-size:12px">
        {{ 'Sent by Craft Analytics from your own server. There is no tracking pixel in this email.'|t('craft-analytics') }}
    </p>
</div>
