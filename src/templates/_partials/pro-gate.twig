{# Shown to Lite instead of a Pro report.

   Said once, plainly, with no countdown and no repetition. A feature you
   don't have should be explained, not advertised at. #}
<div class="ca-card">
    <div class="ca-card-body">
        <div class="ca-posture is-consent">
            <div class="ca-posture-icon" aria-hidden="true">★</div>
            <div>
                <div class="ca-posture-title">{{ title }} {{ 'is a Pro feature'|t('craft-analytics') }}</div>
                <p class="ca-posture-body">{{ description }}</p>
                <p style="margin-top: 10px">
                    <a class="go" href="{{ url('settings/plugins/craft-analytics') }}">
                        {{ 'Plugin settings'|t('craft-analytics') }}
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>
