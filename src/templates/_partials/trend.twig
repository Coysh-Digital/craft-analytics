{# Views and unique visitors over time.

   Two series on one axis - both are counts, so there is never a second y-scale.
   Identity never rests on colour: the legend below is server-rendered HTML,
   each series is named in the tooltip, and the chart macro ships a table
   carrying the same numbers for anyone who cannot see the canvas.

   The uniques series is absent rather than flat when a range has no per-hour
   unique counts to merge; a line pinned to the axis would read as "nobody was
   unique" rather than "this range cannot answer that". #}

{% import 'craft-analytics/_partials/chart.twig' as chart %}

{% set payload = craft.craftAnalytics.trendChart(trend) %}

<div class="ca-card">
    <div class="ca-card-head">
        <h2 class="ca-card-title">{{ 'Traffic'|t('craft-analytics') }}</h2>
        <div class="ca-legend">
            <span><i class="ca-swatch" style="background: var(--ca-views)"></i>{{ 'Pageviews'|t('craft-analytics') }}</span>
            {% if payload.hasUniques %}
                <span><i class="ca-swatch" style="background: var(--ca-uniques)"></i>{{ 'Unique visitors'|t('craft-analytics') }}</span>
            {% endif %}
        </div>
    </div>
    <div class="ca-card-body">
        {{ chart.chart('ca-trend', payload, {
            label: 'Pageviews and unique visitors over time.'|t('craft-analytics'),
            caption: 'Traffic over time'|t('craft-analytics'),
            labelHeading: trend.hourly ? 'Hour'|t('craft-analytics') : 'Date'|t('craft-analytics'),
        }) }}
    </div>
</div>
