{% import 'craft-analytics/_partials/macros.twig' as ca %}

{# Traffic for one entry, in the entry editor — the thing a generic analytics
   tool structurally cannot show you here. #}
<fieldset class="ca">
    <legend class="h6">{{ 'Analytics'|t('craft-analytics') }}</legend>

    {% if stats.views > 0 %}
        <div class="ca-sidebar-stats">
            <div class="ca-sidebar-stat">
                <div class="ca-kpi-label">{{ 'Views'|t('craft-analytics') }}</div>
                <div class="ca-kpi-value">{{ ca.compact(stats.views) }}</div>
            </div>
            <div class="ca-sidebar-stat">
                <div class="ca-kpi-label">{{ 'Visitors'|t('craft-analytics') }}</div>
                <div class="ca-kpi-value">{{ ca.compact(stats.uniques) }}</div>
            </div>
        </div>

        {% set path = craft.craftAnalytics.sparklinePath(stats.series, 200, 30) %}
        {% if path %}
            <svg class="ca-sparkline" viewBox="0 0 200 30" preserveAspectRatio="none" role="img"
                 aria-label="{{ 'Daily views over the last 30 days'|t('craft-analytics') }}">
                <path d="{{ path }}" fill="none" stroke="var(--ca-views)" stroke-width="1.5"
                      stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"></path>
            </svg>
        {% endif %}

        <div class="ca-kpi-sub">{{ 'Last 30 days'|t('craft-analytics') }}</div>
    {% else %}
        <div class="ca-kpi-sub">{{ 'No views recorded in the last 30 days.'|t('craft-analytics') }}</div>
    {% endif %}
</fieldset>
